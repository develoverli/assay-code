  },
  "bugs": "https://github.com/develoverli/assay-code/issues",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:win": "tauri build --bundles nsis",
    "build:mac": "NODE_OPTIONS=--max-old-space-size=4096 tauri build --target universal-apple-darwin --bundles dmg --config '{\"build\":{\"beforeBuildCommand\":\"pnpm exec vite build\"}}'",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "version:bump": "node scripts/bump-version.mjs"
  },
  "dependencies": {
