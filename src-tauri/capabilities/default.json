{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-start-dragging",
    "core:window:allow-close",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-unminimize",
    "core:window:allow-set-focus",
    "core:window:allow-is-visible",
    "core:window:allow-destroy",
    "core:tray:default",
    "core:menu:default",
    "core:app:allow-default-window-icon",
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "**/graphify-out/*"
        }
      ]
    },
    "opener:allow-reveal-item-in-dir",
    "os:default",
    "notification:default",
    "updater:default",
    "process:allow-restart",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "http://localhost:*"
        },
        {
          "url": "http://127.0.0.1:*"
        },
        {
          "url": "http://*:*"
        },
        {
          "url": "https://*:*"
        }
      ]
    },
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "sql:default",
    "sql:allow-load",
    "sql:allow-execute",
    "sql:allow-select",
    "fs:default",
    {
      "identifier": "fs:allow-read-file",
      "allow": [
        { "path": "**/*.png" },
        { "path": "**/*.PNG" },
        { "path": "**/*.jpg" },
        { "path": "**/*.JPG" },
        { "path": "**/*.jpeg" },
        { "path": "**/*.JPEG" },
        { "path": "**/*.gif" },
        { "path": "**/*.GIF" },
        { "path": "**/*.webp" },
        { "path": "**/*.WEBP" },
        { "path": "**/*.svg" },
        { "path": "**/*.SVG" },
        { "path": "**/*.ico" },
        { "path": "**/*.ICO" },
        { "path": "**/*.bmp" },
        { "path": "**/*.BMP" }
      ]
    },
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [
        {
          "path": "**"
        },
        {
          "path": "**/*"
        }
      ]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [
        {
          "path": "**"
        },
        {
          "path": "**/*"
        }
      ]
    },
    {
      "identifier": "fs:allow-read-dir",
      "allow": [
        {
          "path": "**"
        },
        {
          "path": "**/*"
        }
      ]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [
        {
          "path": "**"
        },
        {
          "path": "**/*"
        }
      ]
    },
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "cmd",
          "cmd": "cmd",
          "args": true
        },
        {
          "name": "sh",
          "cmd": "sh",
          "args": true
        },
        {
          "name": "npx",
          "cmd": "npx",
          "args": true
        },
        {
          "name": "claude",
          "cmd": "claude",
          "args": true
        },
        {
          "name": "opencode",
          "cmd": "opencode",
          "args": true
        },
        {
          "name": "docker",
          "cmd": "docker",
          "args": true
        },
        {
          "name": "git",
          "cmd": "git",
          "args": true
        },
        {
          "name": "pnpm",
          "cmd": "pnpm",
          "args": true
        }
      ]
    },
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "cmd",
          "cmd": "cmd",
          "args": true
        },
        {
          "name": "sh",
          "cmd": "sh",
          "args": true
        },
        {
          "name": "npx",
          "cmd": "npx",
          "args": true
        },
        {
          "name": "claude",
          "cmd": "claude",
          "args": true
        },
        {
          "name": "opencode",
          "cmd": "opencode",
          "args": true
        },
        {
          "name": "docker",
          "cmd": "docker",
          "args": true
        },
        {
          "name": "git",
          "cmd": "git",
          "args": true
        },
        {
          "name": "pnpm",
          "cmd": "pnpm",
          "args": true
        }
      ]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [
        {
          "path": "**"
        },
        {
          "path": "**/*"
        }
      ]
    },
    {
      "identifier": "fs:allow-remove",
      "allow": [
        {
          "path": "**"
        },
        {
          "path": "**/*"
        }
      ]
    },
    {
      "identifier": "fs:allow-watch",
      "allow": [
        {
          "path": "**"
        }
      ]
    },
    "fs:allow-unwatch",
    {
      "identifier": "fs:allow-stat",
      "allow": [
        {
          "path": "**"
        },
        {
          "path": "**/*"
        }
      ]
    }
  ]
}
